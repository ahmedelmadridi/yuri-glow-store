# ========================================================
# Yuri Glow - إعدادات البيئة (Environment Variables)
# ========================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# إعدادات أمان لوحة التحكم (Admin Security)
# كلمة المرور الاحتياطية الأولى (قبل التغيير الأول من اللوحة)
ADMIN_PASSWORD=your_strong_admin_password
# مفتاح سري عشوائي لتشفير جلسات الدخول
ADMIN_SESSION_SECRET=create_a_long_random_secret_string_here

# البريد الإلكتروني للمدير (لاستلام أكواد تأكيد تغيير كلمة المرور وتنبيهات الأمان)
ADMIN_EMAIL=yuri.glow.eg@gmail.com

# إعدادات خادم البريد المجاني (Gmail SMTP عبر Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yuri.glow.eg@gmail.com
# كلمة مرور التطبيقات من جوجل (Google App Password) - وليست كلمة مرور بريدك العادية
SMTP_PASS=your_16_char_google_app_password

# إشعارات تيليجرام (مفعلة تلقائياً كطبقة أمان إضافية)
TELEGRAM_BOT_TOKEN=8758380465:AAGqNLIADg8xXtf_WRs5px6qwVPnYk0aeqc
TELEGRAM_CHAT_ID=1023274394
